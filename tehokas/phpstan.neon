includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        -
            # Larastan cannot resolve the `overdue()` scope's #[Scope] attribute when it is
            # called on a `Builder<Task>` inside a closure passed to `withCount()`. Duplicating
            # the overdue condition here instead would create two sources of truth for the
            # "overdue" rule, so the call is kept and the false positive is ignored instead.
            message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Builder(<.*>)?::overdue\(\)\.$#'
            identifier: method.notFound
            path: app/Models/Project.php
        -
            # fakerphp/faker's Company provider (which defines catchPhrase()) is registered on
            # the default Generator at runtime, but the base Generator class's PHPDoc @method
            # stubs (used by PHPStan/Larastan for static resolution) never list it, so this is a
            # stub gap in the library rather than a real bug.
            message: '#^Call to an undefined method Faker\\Generator::catchPhrase\(\)\.$#'
            identifier: method.notFound
            path: database/factories/ProjectFactory.php
